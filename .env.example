# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# Note: .env.local is gitignored and won't be committed to the repository

# InstantDB Configuration
# Required: Get your App ID from https://instantdb.com
# This is used for the database and authentication
NEXT_PUBLIC_INSTANTDB_APP_ID=your_instantdb_app_id_here

# Required for server API routes: GET /api/week-menu, POST /api/menu/vote
# Put this file in the project root (next to package.json). Restart `npm run dev` after edits.
# Dashboard: https://instantdb.com/dash → your app → Admin (backend admin token). Never commit; do not use NEXT_PUBLIC_ prefix.
INSTANT_APP_ADMIN_TOKEN=your_instant_admin_token_here

# Optional: protect those API routes (Authorization: Bearer <this value>)
MENU_PLANNER_API_KEY=your_random_secret_here

# OpenAI Configuration
# Required for AI Menu Generation feature
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
